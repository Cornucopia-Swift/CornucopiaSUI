/* VIN keyboard — German automotive convention uses "FIN" (Fahrzeug-Identifizierungsnummer) */
"Enter VIN" = "FIN eingeben";
"Clear VIN" = "FIN löschen";
"Stop VIN scan" = "FIN-Scan beenden";
"Scan VIN" = "FIN scannen";
"Scan VIN with camera" = "FIN mit Kamera scannen";
"Camera scanner unavailable" = "Kamera-Scanner nicht verfügbar";
"Enter the VIN with the keypad." = "FIN über die Tastatur eingeben.";
"No vehicle details" = "Keine Fahrzeugdaten";
"Looking up…" = "Suche läuft…";
"Looking up vehicle" = "Fahrzeug wird ermittelt";
"Delete" = "Löschen";
"Submit VIN" = "FIN bestätigen";
"VIN %@" = "FIN %@";

/* VoiceOver: value-field label and spoken state announcements */
"VIN" = "FIN";
"empty" = "leer";
"Valid VIN" = "Gültige FIN";
"Valid VIN, check digit warning" = "Gültige FIN, Prüfziffer-Warnung";
"Invalid characters" = "Ungültige Zeichen";
"VIN too long" = "FIN zu lang";

/* Hex keypad */
"Hex payload" = "Hex-Daten";
"Clear hex payload" = "Hex-Daten löschen";
"Hex %@" = "Hex %@";
"Delete" = "Löschen";

/* IPv4 keypad */
"IPv4 address" = "IPv4-Adresse";
"Clear IPv4 address" = "IPv4-Adresse löschen";
"Submit IPv4 address" = "IPv4-Adresse bestätigen";
"IPv4 %@" = "IPv4 %@";

/* MAC keypad */
"MAC address" = "MAC-Adresse";
"Clear MAC address" = "MAC-Adresse löschen";
"Submit MAC address" = "MAC-Adresse bestätigen";
"MAC %@" = "MAC %@";
